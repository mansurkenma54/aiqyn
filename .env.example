# ============================================================
#  AIQYN — құпия кілттер
#
#  Осы файлдың көшірмесін жасап, атын «.env» деп өзгертіңіз,
#  содан кейін кілттерді қойыңыз. Үшеуі де МІНДЕТТІ ЕМЕС —
#  кілт болмаса, жүйе бұрынғыдай толық жұмыс істей береді.
# ============================================================


# ------------------------------------------------------------
# 1) ИИ-ТЕКСЕРУШІ  (ең пайдалысы — жалған детекцияны азайтады)
#
#    YOLO «шұңқыр» деп тапқан суретті екінші ИИ қарап шығып,
#    «бұл шынымен шұңқыр ма?» деген сұраққа жауап береді.
#    Жалған детекция (көлеңке, ескі жамау, шалшық) сүзіледі.
#
#    Тегін кілт алу:  https://aistudio.google.com/apikey
#    (Google есептік жазбасымен кіру → «Create API key» → көшіру)
#    Тегін лимит: тәулігіне мыңдаған сұрау — хакатонға әбден жетеді.
# ------------------------------------------------------------
AIQYN_AI_PROVIDER=gemini
AIQYN_AI_API_KEY=
AIQYN_AI_MODEL=gemini-2.5-flash

#    Басқа қызметті қаласаңыз (OpenRouter, Groq, жергілікті модель):
#    AIQYN_AI_PROVIDER=openai
#    AIQYN_AI_BASE_URL=https://openrouter.ai/api/v1
#    AIQYN_AI_MODEL=<модель атауы>
AIQYN_AI_BASE_URL=


# ------------------------------------------------------------
# 2) TELEGRAM ХАБАРЛАМАСЫ  (демо кезінде әсерлі)
#
#    Жаңа ақау табылған сәтте оператордың телефонына фотосымен
#    бірге хабар келеді.
#
#    Кілт алу:
#      1. Telegram-да @BotFather-ды тауып, /newbot жазыңыз
#      2. Бот атауын беріп, токенді көшіріңіз -> TOKEN
#      3. Өз ботыңызға кез келген хабар жазыңыз
#      4. Мына сілтемені браузерден ашыңыз:
#         https://api.telegram.org/bot<TOKEN>/getUpdates
#         Ішінен "chat":{"id":123456789} санын алыңыз -> CHAT_ID
#    Толығымен тегін.
# ------------------------------------------------------------
AIQYN_TELEGRAM_TOKEN=
AIQYN_TELEGRAM_CHAT_ID=

#    Тек ауыр ақаулар туралы хабарлау (high | medium | low)
AIQYN_TELEGRAM_MIN_SEVERITY=medium


# ------------------------------------------------------------
# 3) 2ГИС МЕКЕНЖАЙЫ  (Шымкент мекенжайлары әлдеқайда дәл)
#
#    Әдепкі күйде тегін OpenStreetMap (Nominatim) қолданылады —
#    кілт қажет емес, бірақ Қазақстан көшелерін нашар біледі.
#    2ГИС Шымкентті әлдеқайда жақсы біледі.
#
#    Тегін кілт алу:  https://dev.2gis.com/  ->  «Получить ключ»
#    (Catalog API / Geocoder, тегін тариф бар)
# ------------------------------------------------------------
AIQYN_2GIS_KEY=


# ------------------------------------------------------------
# 4) САЙТ
# ------------------------------------------------------------
AIQYN_ADMIN_USER=admin
#    Әдепкі «aiqyn2026» тек жергілікті демо үшін — өзіңіздікін қойыңыз
AIQYN_ADMIN_PASSWORD=

#    Камера программасы → сайт кілті. Қойылса, сайт құжатты тек осы
#    кілтпен қабылдайды. Vision мен Portal-да БІРДЕЙ мән болуы керек.
#    Жасау:  python -c "import secrets; print(secrets.token_urlsafe(24))"
AIQYN_INGEST_TOKEN=

#    Хаттағы сілтемелердің түбірі. localhost БОЛМАУЫ керек — хатты
#    алушы оны аша алмайды. Vercel-де автоматты анықталады.
AIQYN_PORTAL_PUBLIC_URL=


# ============================================================
#  5) ӨТІНІМДІ ЖЕТКІЗУ  (ЕКЦ 109 интеграциясы)
#
#  Ең оңай жолы — қолмен емес, шебермен:
#      python scripts/setup_delivery.py
#  Ол сұрайды, .env-ге жазады және БІРДЕН сынақ жібереді.
# ============================================================


# ---- 5.1  EMAIL: BREVO  (ҰСЫНЫЛАДЫ) ------------------------
#
#  Неге Brevo: қосымша құпиясөз (app password) де, домен де, екі
#  сатылы кіру де қажет емес. Vercel-де де жұмыс істейді — serverless
#  ортада Gmail-дың 587-порты жиі жабық.
#
#    1. https://www.brevo.com → тіркелу (тегін, 300 хат/күн)
#    2. Senders, Domains & Dedicated IPs → Senders → Add a sender
#       → өз поштаңызды қосып, РАСТАҢЫЗ
#    3. SMTP & API → API Keys → Generate a new API key
#
AIQYN_MAIL_PROVIDER=
AIQYN_BREVO_KEY=
AIQYN_MAIL_FROM=


# ---- 5.2  EMAIL: GMAIL SMTP  (баламасы) --------------------
#
#  ТЕК «қосымша құпиясөзбен» істейді, өз құпиясөзіңізбен ЕМЕС:
#    1. Екі сатылы кіру ҚОСУЛЫ болуы керек:
#       https://myaccount.google.com/signinoptions/twosv
#    2. https://myaccount.google.com/apppasswords → 16 таңбалы код
#
#  Бет «қолжетімді емес» десе — не 2FA қосылмаған, не бұл мектеп/жұмыс
#  аккаунты (әкімші өшірген). Ондай жағдайда 5.1-ді қолданыңыз.
#
AIQYN_SMTP_HOST=
AIQYN_SMTP_PORT=587
AIQYN_SMTP_USER=
AIQYN_SMTP_PASSWORD=
AIQYN_SMTP_FROM=


# ---- 5.3  КІМГЕ БАРАДЫ -------------------------------------
#
#  Кезегі: FORCE_TO → аймақтың жауапты ұйымы → DELIVERY_TO → жіберуші.
#
#  ДЕМО КЕЗІНДЕ FORCE_TO-ны өз поштаңызға қойыңыз: сонда өтінім
#  аймақтың мекенжайына қарамай, тек сізге түседі. Сахнада нақты
#  мемлекеттік мекемеге қате хат кетіп қалмауының кепілі.
#
#  ЕСКЕРТУ: нақты мекеменің поштасын келісімсіз қоюға БОЛМАЙДЫ —
#  растаусыз ресми өтінім жалған шағым болып саналады.
#
AIQYN_DELIVERY_FORCE_TO=
AIQYN_DELIVERY_TO=
AIQYN_DELIVERY_CC=


# ---- 5.4  WHATSAPP  (кілтсіз ЖҰМЫС ІСТЕЙДІ) ----------------
#
#  Нөмір қойылса, жүйе әр өтінімге дайын мәтінмен сілтеме жасайды —
#  оператор порталдағы «WhatsApp» батырмасын басады да, хабар кетеді.
#  Ешқандай тіркелу де, кілт те қажет емес.
#
AIQYN_DELIVERY_WHATSAPP=

#  Толық автоматты жіберу (Meta Cloud API) — міндетті емес
AIQYN_WA_TOKEN=
AIQYN_WA_PHONE_ID=


# ---- 5.5  РЕСМИ 109 ЭНДПОЙНТІ ------------------------------
#
#  Әкімдік ресми API берген күні — сілтемені осында қою жеткілікті,
#  кодта ештеңе өзгермейді. Бос болса, өтінім жергілікті тікет
#  журналына жазылады (аудит ізі) да, «эндпойнт жоқ» деп ашық
#  көрсетіледі — жалған «жіберілді» ешқашан жазылмайды.
#
AIQYN_109_URL=
AIQYN_109_TOKEN=


# ---- 5.6  АВТОМАТТЫ ЖІБЕРУ ---------------------------------
#
#  ӘДЕПКІ КҮЙІ — ӨШІРУЛІ, солай қалғаны дұрыс: расталмаған автоматты
#  өтінім жалған шағым болып саналуы мүмкін.
#
AIQYN_AUTO_SEND=false
AIQYN_AUTO_SEND_MIN_CONFIDENCE=0.85
AIQYN_AUTO_SEND_MIN_SEVERITY=high
AIQYN_AUTO_SEND_REQUIRE_AI=true
AIQYN_AUTO_SEND_REQUIRE_GPS=true
